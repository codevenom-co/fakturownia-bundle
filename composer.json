{
  "name": "codevenom/fakturownia-bundle",
  "description": "Symfony bundle for Fakturownia API with built-in MCP tools",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "symfony/framework-bundle": "^6.4 || ^7.3 || ^8.0",
    "symfony/http-client": "^6.4 || ^7.3 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.3 || ^8.0",
    "symfony/serializer": "^6.4 || ^7.3 || ^8.0",
    "symfony/validator": "^6.4 || ^7.3 || ^8.0"
  },
  "suggest": {
    "symfony/mcp-bundle": "To use the built-in MCP tools (^0.7.0 || ^0.8.0)"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^1.10",
    "symfony/dotenv": "^7.3 || ^8.0",
    "symfony/mcp-bundle": "^0.7.0 || ^0.8.0"
  },
  "autoload": {
    "psr-4": {
      "Codevenom\\FakturowniaBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codevenom\\FakturowniaBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite Unit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:all": "phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
