{
  "name": "codevenom/fakturownia-bundle",
  "description": "Symfony bundle for Fakturownia API with built-in MCP tools",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^6.4 || ^7.0",
    "symfony/http-client": "^6.4 || ^7.0",
    "symfony/mcp-bundle": "^0.6"
  },
  "autoload": {
    "psr-4": {
      "Codevenom\\FakturowniaBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codevenom\\FakturowniaBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
